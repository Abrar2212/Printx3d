# PrintX3D — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# ─── PostgreSQL ───────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Keep this on your local database; the live one is set in the Render dashboard.
DATABASE_URL="postgresql://postgres:password@localhost:5432/printx3d"

# ─── Staff login (see lib/auth.ts) ────────────────────────────
# Signs the login cookie. Any random string, 32+ characters.
# Changing it logs everyone out at once.
NEXTAUTH_SECRET="REPLACE_WITH_A_STRONG_SECRET_32_CHARS"

# Reception: order queue + STL downloads. Admin: everything.
# Use long passphrases. Changing one blocks new logins with the old one;
# people already logged in stay in for up to 12 hours (change NEXTAUTH_SECRET to end that).
STAFF_PASSWORD="REPLACE_WITH_STAFF_PASSPHRASE"
ADMIN_PASSWORD="REPLACE_WITH_ADMIN_PASSPHRASE"

# ─── Payment Gateway (optional) ───────────────────────────────
PAYMENT_WEBHOOK_SECRET="your_payment_webhook_secret"
